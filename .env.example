# BloodConnect Environment Configuration Example
# Copy to .env and configure for local development

# Environment: development, testing, production
ENVIRONMENT=development
PROJECT_NAME="BloodConnect"
API_V1_STR=/api/v1

# Security & Tokens
# Generate a secure secret in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=bloodconnect_super_secret_dev_key_change_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
# Default: PostgreSQL container/native.
# Fallback for development if PostgreSQL is not active: sqlite+aiosqlite:///./bloodconnect.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bloodconnect
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloodconnect

# Default Super Admin Seed Credentials (Development Only)
FIRST_SUPERUSER_EMAIL=admin@bloodconnect.local
FIRST_SUPERUSER_PASSWORD=Admin@BloodConnect2026!

# CORS Origins (comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Reservation rules
DEFAULT_RESERVATION_TIMEOUT_MINUTES=30
